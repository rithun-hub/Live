# LIVE Platform Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database configuration:
# Default zero-setup SQLite:
DATABASE_URL="file:./dev.db"
# Or PostgreSQL:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/live_db?schema=public"

# Authentication Secrets
JWT_ACCESS_SECRET="your_jwt_access_secret_here"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_here"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Video & Download Controls
DEFAULT_DAILY_DOWNLOAD_LIMIT=10

# WebRTC STUN / TURN
STUN_SERVER="stun:stun.l.google.com:19302"
TURN_SERVER=""
TURN_USERNAME=""
TURN_CREDENTIAL=""

# Multilingual Translation Service (Optional External API)
TRANSLATION_API_KEY=""

